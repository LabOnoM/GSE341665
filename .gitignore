# ── Large primary data (archived on Zenodo, not in Git) ──────────────
# The data/ and reference/ folders keep only their FILELIST.md manifests.
data/**
!data/**/
!data/**/FILELIST.md
reference/**
!reference/FILELIST.md

# ── Pipeline outputs (regenerated by the code) ───────────────────────
pipeline/output/
pipeline/figures/*.pdf
*.Rdata
*.RData

# ── Language / tooling cruft ─────────────────────────────────────────
__pycache__/
*.pyc
.Rhistory
.RData
.Rproj.user/
.ipynb_checkpoints/
.DS_Store
*.log

# ── Office lock/temp files ───────────────────────────────────────────
.~lock.*#
~$*
